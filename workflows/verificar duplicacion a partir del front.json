    {
      "parameters": {
        "jsCode": "const rawText = $node[\"Basic LLM Chain\"].json.text;\n\n// Buscamos lo que hay entre las primeras llaves { }\nconst jsonMatch = rawText.match(/\\{[\\s\\S]*?\\}/);\n\nif (jsonMatch) {\n  try {\n    const parsed = JSON.parse(jsonMatch[0]);\n    return {\n      isDuplicate: parsed.isDuplicate ?? false,\n      matchScore: parsed.matchScore ?? 0,\n      reason: parsed.reason ?? \"Sin descripción\",\n      duplicateEventId: parsed.duplicateEventId ?? null\n    };\n  } catch (e) {\n    return { error: \"Error de parseo\", raw: rawText };\n  }\n}\n\nreturn { isDuplicate: false, reason: \"No se encontró JSON en la respuesta\" };"
      },
