              "id": "e0c138b5-9eaf-467c-9360-2ab293487a5a",
              "leftValue": "={{\n  (() => {\n    // 1. Obtenemos el ID que viene del Webhook\n    const idWebhook = $('Webhook').item.json.body.id;\n\n    // 2. Obtenemos la lista del nodo Aggregate (si es nula, usamos un array vacío)\n    const lista = $json.lista_eventos || [];\n\n    // 3. Lógica de salida:\n    // - Si la lista está vacía (length === 0) -> True\n    // - O si alguno de los eventos de la lista tiene el mismo ID -> True\n    return lista.length === 0 || lista.some(evento => evento.id === idWebhook);\n  })()\n}}",
